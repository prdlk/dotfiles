{{- /* chezmoi init asks two things, in this order:

1. The master password, once per machine: it decrypts key.txt.age (the age
   identity, passphrase-encrypted and committed) to ~/.config/chezmoi/key.txt,
   which decrypts every encrypted_ file. Skipped once that key exists. Enter
   alone, three wrong tries, or no terminal skip it: without the key,
   .chezmoiignore.tmpl leaves every encrypted_ file out of the apply.
2. The software to install: every package choice from .chezmoidata/
   packages.yaml (.chezmoitemplates/packages), with the previous answer
   preselected and anything new preselected too. The unchosen ones are
   stored as data.skip, so packages added later still install. `chezmoi init`
   asks again; `chezmoi init --promptDefaults` keeps the previous answer.

Name and email for git are .chezmoidata/user.yaml, not prompted. */ -}}
{{- $identity := joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" -}}
{{- $encrypted := joinPath .chezmoi.sourceDir "key.txt.age" -}}
{{- if and (not (stat $identity)) (stat $encrypted) -}}
{{-   $_ := output "sh" "-c" `
mkdir -p "$(dirname "$1")"
if ! (: </dev/tty) 2>/dev/null; then
    echo "chezmoi: no terminal for the master password; secrets skipped" >&2
    exit 0
fi
trap 'stty echo </dev/tty' EXIT INT TERM
for try in 1 2 3; do
    printf 'Master password (enter to skip secrets): ' >/dev/tty
    stty -echo </dev/tty
    IFS= read -r password </dev/tty || password=''
    stty echo </dev/tty
    echo >/dev/tty
    if [ -z "$password" ]; then
        echo "Secrets skipped; run chezmoi init again to add them." >/dev/tty
        exit 0
    fi
    # --no-tty: chezmoi reads the passphrase from stdin instead of the terminal.
    if printf '%s\n' "$password" | "$0" --no-tty age decrypt --passphrase --output "$1" "$2" >/dev/null 2>&1; then
        chmod 600 "$1"
        exit 0
    fi
    echo "Wrong password." >/dev/tty
done
echo "Secrets skipped after three tries; run chezmoi init again to add them." >/dev/tty
` .chezmoi.executable $identity $encrypted -}}
{{- end -}}
{{- $names := (includeTemplate "packages" dict | fromJson).names -}}
{{- $previous := get . "skip" | default list -}}
{{- $preselected := list -}}
{{- range $names }}{{ if not (has . $previous) }}{{ $preselected = append $preselected . }}{{ end }}{{ end -}}
{{- $install := promptMultichoice "Software to install (x toggles, ctrl+a selects all, enter confirms)" $names $preselected -}}
{{- $skip := list -}}
{{- range $names }}{{ if not (has . $install) }}{{ $skip = append $skip . }}{{ end }}{{ end -}}

mode = "symlink"
encryption = "age"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1v6j26xeydxgn5vtv2unjszd5aq6a0l6s50plc6x539u95usmhyeqxcup96"
    useBuiltin = true

[data]
    # Software not to install, from the init picker (.chezmoitemplates/packages).
    skip = {{ $skip | toToml }}
