#!/bin/sh
# Tools that come from their own installers rather than the OS package
# manager: rustup (cargo) and the chosen packages.shared.cargo crates, mise
# itself on Ubuntu, and the chosen global mise tools: packages.shared.mise on
# every OS plus, on Ubuntu, the chosen packages.tools entries that have a
# `mise` spec and no `apt` (.chezmoitemplates/packages).
# Runs before 20-gh-extensions, whose fish session sources ~/.cargo/env.fish
# (conf.d/rustup.fish) and activates mise. The rendered lists change with the
# manifest or the choice, which re-runs this.
{{- $family := includeTemplate "os-family" . }}
{{- $pk := includeTemplate "packages" . | fromJson }}
{{- $mise := $pk.mise }}
{{- if eq $family "debian" }}
{{-   range $pk.tools }}
{{-     if and (hasKey . "mise") (not (hasKey . "apt")) }}{{ $mise = append $mise .mise }}{{ end }}
{{-   end }}
{{- end }}
set -eu

# Where rustup puts cargo and mise.run puts mise; chezmoi's environment can
# predate the shell config that adds them.
PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
export PATH
{{- if eq $family "darwin" }}
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$brew" ] && eval "$("$brew" shellenv)" && break
done
{{- else if eq $family "debian" }}

# mise is in neither the Ubuntu archive nor this manifest's apt list.
command -v mise >/dev/null 2>&1 || curl -fsSL https://mise.run | sh
{{- end }}

{{- if $pk.cargo }}

# rustup: -y answers its prompt (no tty under chezmoi); --no-modify-path keeps
# it out of the shell rc files, which are symlinks into this repo and already
# source ~/.cargo/env (bash, zsh, fish conf.d/rustup.fish).
if ! command -v cargo >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

installed=$(cargo install --list | awk '/^[^ ]/{print $1}')
{{ range $pk.cargo -}}
echo "$installed" | grep -qx {{ . | quote }} || cargo install --locked {{ . | quote }}
{{ end }}
{{- end }}
{{- if $mise }}

# Global mise tools. Only tools absent from the global config are added, so a
# local pin (node = "22") is never rewritten to latest; `mise install` then
# fetches any configured version that is not installed yet.
if command -v mise >/dev/null 2>&1; then
    global=$(mise ls --global --json)
    missing=''
    for tool in{{ range $mise }} {{ . | quote }}{{ end }}; do
        echo "$global" | jq -e --arg t "${tool%@*}" 'has($t)' >/dev/null || missing="$missing $tool"
    done
    # shellcheck disable=SC2086 # one word per tool
    [ -z "$missing" ] || mise use -g $missing
    mise install{{ range $mise }} {{ . | quote }}{{ end }}
    # omp's own installer (omp.sh/install) put a binary in ~/.local/bin, which
    # precedes mise's shims on PATH; drop it once mise provides omp.
    if [ -f "$HOME/.local/bin/omp" ] && [ ! -L "$HOME/.local/bin/omp" ] && mise which omp >/dev/null 2>&1; then
        rm -f "$HOME/.local/bin/omp"
    fi
else
    echo "warning: mise not installed — skipping mise tools" >&2
fi
{{- end }}
