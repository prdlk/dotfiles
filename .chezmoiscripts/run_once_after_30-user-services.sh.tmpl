{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Enable session-critical user services. Personal automation units
# (brain-lens, omp-loop, rclone, hermes, voxtype) ship as files only —
# enable manually per machine.
set -eu

# Pre-shutdown save of kitty's daily session (dot_config/systemd/user, only on
# linux desktop/laptop roles; see .chezmoiignore.tmpl).
if [ -f "$HOME/.config/systemd/user/kitty-day-save.service" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload || true
    systemctl --user enable --now kitty-day-save.service || true
fi

# Symlink ~/Code repos into ~/Projects every 5 min (same role gate).
if [ -f "$HOME/.config/systemd/user/projects-sync.timer" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload || true
    systemctl --user enable --now projects-sync.timer || true
fi
{{ else -}}
#!/bin/sh
exit 0
{{ end -}}
