#!/bin/sh
# Install the chosen packages.tools entries of .chezmoidata/packages.yaml
# (.chezmoitemplates/packages: all but data.skip from `chezmoi init`) with the
# OS package manager: pacman + AUR on Arch, Homebrew on macOS, apt on Ubuntu.
# Ubuntu's `mise` entries are installed by 15-tools, after mise itself. The
# rendered lists change with the manifest or the choice, which re-runs this.
set -eu

if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi

{{ $family := includeTemplate "os-family" . -}}
{{ $pk := includeTemplate "packages" . | fromJson -}}

{{ if eq $family "arch" -}}
{{- $pacman := list -}}
{{- $aur := list -}}
{{- range $pk.tools -}}
{{-   if hasKey . "arch" }}{{ $pacman = append $pacman .arch }}{{ end -}}
{{-   if hasKey . "aur" }}{{ $aur = append $aur .aur }}{{ end -}}
{{- end -}}
# Install only what no installed package already provides (`pacman -T`), so a
# machine with mise-bin or yazi-git is not asked to replace them with mise/yazi.
install_missing() {
    missing=$(pacman -T "$@" || true)
    # shellcheck disable=SC2086  # word splitting intended
    [ -z "$missing" ] || $SUDO pacman -S --needed --noconfirm $missing
}

{{ if $pacman }}install_missing {{ $pacman | join " " }}{{ end }}

# AUR names no installed package provides yet; ones already installed from a
# sync repo ([omarchy], extra) are neither rebuilt nor replaced.
aur_missing={{ if $aur }}$(pacman -T {{ $aur | join " " }} || true){{ else }}''{{ end }}
if [ -n "$aur_missing" ]; then
    # No AUR helper yet: take yay from a sync repo that ships it, else build
    # yay-bin from the AUR (makepkg refuses root).
    if ! command -v yay >/dev/null 2>&1 && ! command -v paru >/dev/null 2>&1; then
        if pacman -Si yay >/dev/null 2>&1; then
            $SUDO pacman -S --needed --noconfirm yay
        elif [ "$(id -u)" -ne 0 ]; then
            install_missing git base-devel
            yay_build=$(mktemp -d)
            git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$yay_build"
            (cd "$yay_build" && makepkg -si --noconfirm)
            rm -rf "$yay_build"
        fi
    fi
    if command -v yay >/dev/null 2>&1; then AUR="yay"
    elif command -v paru >/dev/null 2>&1; then AUR="paru"
    else AUR=""; fi
    if [ -n "$AUR" ]; then
        # shellcheck disable=SC2086
        $AUR -S --needed --noconfirm $aur_missing
    else
        echo "warning: no yay/paru and none could be bootstrapped — skipping AUR packages:" $aur_missing >&2
    fi
fi

{{ else if eq $family "darwin" -}}
{{- $brew := list -}}
{{- $cask := list -}}
{{- range $pk.tools -}}
{{-   if hasKey . "brew" }}{{ $brew = append $brew .brew }}{{ end -}}
{{-   if hasKey . "cask" }}{{ $cask = append $cask .cask }}{{ end -}}
{{- end -}}
# Homebrew: install it when missing (its installer also brings the Xcode
# command line tools), then put it on PATH for the rest of this script.
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$brew" ] && break
done
if [ ! -x "$brew" ]; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$brew" ] && break
    done
fi
eval "$("$brew" shellenv)"

# Only what is not installed yet, so a run never upgrades anything.
installed=$(brew list --formula -1)
missing=''
for f in {{ $brew | join " " }}; do
    echo "$installed" | grep -qx "$f" || missing="$missing $f"
done
# shellcheck disable=SC2086  # one word per formula
[ -z "$missing" ] || brew install $missing

installed=$(brew list --cask -1)
missing=''
for c in {{ $cask | join " " }}; do
    echo "$installed" | grep -qx "$c" || missing="$missing $c"
done
# shellcheck disable=SC2086  # one word per cask
[ -z "$missing" ] || brew install --cask $missing

{{ else if eq $family "debian" -}}
{{- $apt := list -}}
{{- range $pk.tools -}}
{{-   if hasKey . "apt" }}{{ $apt = append $apt .apt }}{{ end -}}
{{- end -}}
export DEBIAN_FRONTEND=noninteractive
codename={{ .chezmoi.osRelease.versionCodename | quote }}

# Vendor repos for packages the Ubuntu archive lacks or ships too old.
repos_added=0
$SUDO apt-get update -qq
$SUDO apt-get install -y -qq ca-certificates curl gnupg software-properties-common xz-utils >/dev/null

{{- if has "fish" $pk.selected }}
# fish 4 (the archive has 3.7; the fish config targets 4.x).
if ! grep -rqs fish-shell /etc/apt/sources.list.d/; then
    $SUDO add-apt-repository -y -n ppa:fish-shell/release-4
    repos_added=1
fi
{{- end }}
{{- if has "tailscale" $pk.selected }}

# tailscale: not in the archive.
if [ ! -f /etc/apt/sources.list.d/tailscale.list ]; then
    curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/$codename.noarmor.gpg" |
        $SUDO tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
    curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/$codename.tailscale-keyring.list" |
        $SUDO tee /etc/apt/sources.list.d/tailscale.list >/dev/null
    repos_added=1
fi
{{- end }}
[ "$repos_added" -eq 0 ] || $SUDO apt-get update -qq

# shellcheck disable=SC2086  # one word per package
$SUDO apt-get install -y -qq {{ $apt | join " " }}

{{- if has "victor-mono-nerd-font" $pk.selected }}

# Victor Mono Nerd Font: no Ubuntu package; the nerd-fonts release.
fonts="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/VictorMonoNerdFont"
if [ ! -d "$fonts" ]; then
    mkdir -p "$fonts"
    curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/latest/download/VictorMono.tar.xz |
        tar -xJ -C "$fonts"
fi
{{- end }}

{{ else -}}
echo "warning: no package manifest for {{ .chezmoi.os }} {{ if .chezmoi.osRelease }}{{ .chezmoi.osRelease.id }}{{ end }} — skipping packages" >&2
{{ end -}}
