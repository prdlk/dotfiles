#!/bin/sh
# Rebuild bat's syntax/theme cache when managed inputs change.
# themes hash: {{ include "dot_config/bat/themes/cyberdream.tmTheme" | sha256sum }}
# config hash: {{ include "dot_config/bat/config" | sha256sum }}
set -eu
command -v bat >/dev/null 2>&1 || exit 0
bat cache --build >/dev/null
