AGENTS.md
docs

# The passphrase-encrypted age identity; .chezmoi.toml.tmpl decrypts it to
# ~/.config/chezmoi/key.txt at init. Never applied as ~/key.txt.age.
key.txt.age

# Without the age key (master password skipped at `chezmoi init`) every
# encrypted_ file is left out, so apply never tries to decrypt it. Target
# path: the source path minus chezmoi attribute prefixes and `.age`.
{{- if not (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
{{-   range glob (joinPath .chezmoi.sourceDir "**/encrypted_*") }}
{{-     $target := list }}
{{-     range splitList "/" (trimPrefix (printf "%s/" $.chezmoi.sourceDir) .) }}
{{-       $c := regexReplaceAll "^((after|before|create|empty|encrypted|exact|executable|external|literal|modify|once|onchange|private|readonly|remove|run|symlink)_)+" . "" }}
{{-       $target = append $target (regexReplaceAll "^dot_" $c ".") }}
{{-     end }}
{{ join "/" $target | trimSuffix ".age" }}
{{-   end }}
{{- end }}

# free-router (the local freellmapi proxy) runs only on the Omarchy desktop.
{{- if not (lookPath "omarchy") }}
.config/free-router
{{- end }}

# On Omarchy the tmux-palette colours follow the active theme: env/omarchy-desktop
# links ~/.config/tmux-palette/theme.json to the theme's generated
# tmux-palette.json. The cyberdream theme.json here is for every other machine.
{{- if lookPath "omarchy" }}
.config/tmux-palette/theme.json
{{- end }}

