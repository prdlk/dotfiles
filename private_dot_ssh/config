# ~/.ssh/config (chezmoi: private_dot_ssh/config). Keepalives come from
# Omarchy's /etc/ssh/ssh_config.d/20-omarchy-keepalive.conf (15 s x 3).

# goliath: home server, by its Tailscale IPv4 address: one address on the LAN
# and away, no DNS lookup (the LAN's DNS only hands out an IPv6 address).
# mosh takes the address from here (%h), so its UDP session runs over
# Tailscale too. HostKeyAlias keeps the host keys filed under "goliath".
Host goliath
  HostName 100.115.218.84
  HostKeyAlias goliath
  User prad
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  # One shared connection: the first ssh/scp/git authenticates, later ones
  # start instantly and it lingers 10 min after the last closes. mosh's
  # bootstrap ssh runs with -S none and does its own handshake.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
