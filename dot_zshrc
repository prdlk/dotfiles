# ~/.zshrc — managed by chezmoi

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS

# Completion
autoload -Uz compinit && compinit

# PATH extras / tool envs (machine-optional, guarded)
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# Homebrew (macOS) and mise: where .chezmoidata/packages.yaml puts the tools
# that are not in /usr/bin (mise also holds the Ubuntu TUIs and the global
# tools). Before every `command -v` below.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
done
unset _brew
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
[ -d "$HOME/.maestro/bin" ] && PATH="$PATH:$HOME/.maestro/bin"

# Go — GOPATH/GOBIN under ~/.local/share to keep $HOME clean.
# GOROOT is provided by mise (toolchain lives under ~/.local/share/mise).
export GOPATH="$HOME/.local/share/go"
export GOBIN="$GOPATH/bin"
case ":$PATH:" in *":$GOBIN:"*) ;; *) PATH="$GOBIN:$PATH" ;; esac

# Repo roots (ghq) — same as fish's conf.d/10-env.fish; the ghq-repos tv
# cable (ctrl-o) lists this root.
export GHQ_ROOT="$HOME/Code"
export CODE_ROOT="$HOME/Code"

# Android SDK under ~/.local/share/android-sdk. Prepended so they win over the
# legacy AUR android-sdk tools that /etc/profile.d/android-sdk.sh appends.
export ANDROID_HOME="$HOME/.local/share/android-sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
for _adir in "$ANDROID_HOME/emulator" "$ANDROID_HOME/cmdline-tools/latest/bin" "$ANDROID_HOME/platform-tools"; do
    case ":$PATH:" in *":$_adir:"*) ;; *) [ -d "$_adir" ] && PATH="$_adir:$PATH" ;; esac
done
unset _adir
# Gradle/AGP builds (React Native, Expo) need JDK 17; the system default `java` stays as is.
[ -d /usr/lib/jvm/java-17-openjdk ] && export JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# GITHUB_TOKEN from gh's keyring login — never stored on disk. An inherited
# value wins, so nested shells skip the gh call.
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
    _gh_token="$(gh auth token 2>/dev/null)"
    [ -n "$_gh_token" ] && export GITHUB_TOKEN="$_gh_token"
    unset _gh_token
fi

# free-router (localhost freellmapi): FREE_ROUTER_PORT, FREE_ROUTER_API_KEY.
# Same file free-router.service loads; Omarchy machines with the master password only.
if [ -r "$HOME/.config/free-router/env" ]; then
    set -a; . "$HOME/.config/free-router/env"; set +a
fi

# Shared aliases (same set as fish/bash; source of truth: .chezmoidata/aliases.yaml)
[ -f "$HOME/.config/shell/aliases.sh" ] && . "$HOME/.config/shell/aliases.sh"

# Shell functions — one file per function, zsh ports of the fish ones
# (cwd/history-touching helpers; standalone tools live in ~/.local/bin)
if [ -d "$HOME/.config/zsh/functions" ]; then
    for _f in "$HOME/.config/zsh/functions"/*.zsh; do
        [ -r "$_f" ] && . "$_f"
    done
    unset _f
fi

# ZLE keybinds — zsh ports of fish_user_key_bindings.fish
[ -f "$HOME/.config/zsh/keybinds.zsh" ] && . "$HOME/.config/zsh/keybinds.zsh"

# suvadu shell history
command -v suv >/dev/null 2>&1 && eval "$(suv init zsh)"

# Generated for envman. Do not edit.
[ -s "$HOME/.config/envman/load.sh" ] && . "$HOME/.config/envman/load.sh"

# Prompt — starship, consistent with fish
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
    ZLE_RPROMPT_INDENT=0   # right_format ($time) flush with the edge

    # Transient prompt (fish has enable_transience; zsh has no starship
    # built-in): on Enter, collapse the prompt to ❯ + time, restore it next
    # precmd. Must be registered before zsh-syntax-highlighting below.
    # Profiles live in starship.toml; strip add_newline's leading \n.
    _starship_prompt=$PROMPT _starship_rprompt=$RPROMPT
    _starship_profile() {
        local s
        s=$(starship prompt --profile "$1" --status="${STARSHIP_CMD_STATUS:-}")
        print -rn -- "${s#$'\n'}"
    }
    _starship_transient() {
        PROMPT='$(_starship_profile transient)' RPROMPT='$(_starship_profile transient_right)'
        zle .reset-prompt
    }
    _starship_restore() { PROMPT=$_starship_prompt RPROMPT=$_starship_rprompt; }
    autoload -Uz add-zle-hook-widget && add-zle-hook-widget line-finish _starship_transient
    add-zsh-hook precmd _starship_restore
fi

# Window title — port of fish_title.fish (+ tmux window name, as in
# fish's conf.d/50-terminal-title.fish)
_set_win_title() {
    local t=${(%):-%~}
    [[ -n $SSH_TTY ]] && t="${${(%):-%m}[1,10]}:$t"
    printf '\e]0;%s\a' "$t"
    [[ -n $TMUX ]] && printf '\ek%s\e\\' "$t"
}
autoload -Uz add-zsh-hook && add-zsh-hook precmd _set_win_title

# television: ctrl-t smart autocomplete (its ctrl-r is taken over by atuin
# below, as in fish)
command -v tv >/dev/null 2>&1 && eval "$(tv init zsh)"

# Fish-style syntax highlighting (zsh-users/zsh-syntax-highlighting).
# MUST stay last in .zshrc: it wraps every zle widget defined above
# (keybinds, compinit, suv/starship hooks).
for _zsh_hl in \
    /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    "${HOMEBREW_PREFIX:-/usr/local}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
    [ -r "$_zsh_hl" ] && . "$_zsh_hl" && break
done
unset _zsh_hl

# atuin comes from the package manager (/usr/bin); see ~/.bashrc.
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

