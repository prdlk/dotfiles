#!/bin/sh
# fzf-pick LeetCode solution files and run /leetcode-eli5 on each via omp.
root=${1:-.}

# Match only numbered problem files: 1365.some-slug.js anywhere in the tree
files=$(fd --type f '^\d+\..+\.(js|ts)$' "$root" \
    | fzf --multi \
          --prompt='eli5> ' \
          --delimiter=/ \
          --with-nth=-3.. \
          --preview 'bat --color=always --line-range=:40 {}' \
          --preview-window=right:60%)
[ -n "$files" ] || exit 1

printf '%s\n' "$files" | while IFS= read -r f; do
    echo "── /leetcode-eli5 $f"
    omp -p "/leetcode-eli5 $f"
done
