#!/bin/bash
# Ghostty's `command`: every Ghostty window gets its own tmux session, never
# a mirror of another window's. Reclaim the oldest detached session (left by
# a closed window, or restored by tmux-continuum after a reboot) so closed
# windows don't pile up sessions; otherwise start a new one. pj-palette's
# background sessions (@pj_task, <session>:omp) are never reclaimed, and
# targets use the session id since names may contain ':'.
# The first window after boot starts the server, which is what triggers
# continuum's restore.
# ponytail: two windows opened in the same instant can claim the same detached
# session; take a lock (flock) here if that ever bites.

# A server started here inherits this PATH. Ghostty launched from the desktop
# or the macOS Dock has no shell init (macOS: PATH is /usr/bin:/bin:/usr/sbin:
# /sbin), so add where tmux itself and the tools tmux plugins shell out to
# live: Homebrew's prefix (macOS: tmux, bun, fzf, zoxide), mise's shims
# (Ubuntu's tmux, bun for tmux-palette, fzf, zoxide) and cargo's bin for the
# cargo-installed ones (wt, which lazygit's worktree keys call from the
# prefix g popup). Arch's tmux is /usr/bin/tmux, already on PATH.
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $brew ]] && { PATH="${brew%/bin/brew}/bin:${brew%/bin/brew}/sbin:$PATH"; break; }
done
[[ -d $HOME/.local/share/mise/shims ]] && PATH="$HOME/.local/share/mise/shims:$PATH"
[[ -d $HOME/.cargo/bin ]] && PATH="$HOME/.cargo/bin:$PATH"
export PATH

if ! tmux=$(command -v tmux); then
    printf 'ghostty-tmux: no tmux on PATH (%s); starting %s instead\n' "$PATH" "${SHELL:-/bin/sh}" >&2
    exec "${SHELL:-/bin/sh}" -l
fi

oldest=$("$tmux" list-sessions -f '#{&&:#{==:#{session_attached},0},#{!:#{@pj_task}}}' \
    -F '#{session_created} #{session_id}' 2>/dev/null | sort -n | head -1 | cut -d' ' -f2)

[[ -n $oldest ]] && exec "$tmux" attach-session -t "$oldest"
exec "$tmux" new-session
